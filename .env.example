# --- API keys (required) ---
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- Infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gatewaypass
REDIS_URL=redis://localhost:6379/0

# --- Tuning (optional, these are the defaults) ---
# EMBEDDING_MODEL=voyage-3.5
# CACHE_HIT_THRESHOLD=0.95
# GRAPH_SIMILARITY_THRESHOLD=0.75
# GRAPH_CONTEXT_LIMIT=6
# RATE_LIMIT_PER_MINUTE=30
# SIMPLE_MODEL=claude-haiku-4-5
# COMPLEX_MODEL=claude-sonnet-5
# COMPLEX_PROMPT_CHARS=600
