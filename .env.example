# Copy to .env, generate unique random values, then run docker compose up --build.
# Never commit .env. Secret values below are intentionally empty.
ENVIRONMENT=development
AUTH_ENABLED=true
# Map each >=32-character bearer token to a tenant ID. Multiple keys may share a tenant.
GATEWAY_API_KEYS={}
# Dedicated >=32-character token for global metrics; empty disables access.
METRICS_BEARER_TOKEN=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Generate URL-safe random values: python -c 'import secrets; print(secrets.token_hex(24))'
# For this Compose example use URL-safe passwords (hex is convenient).
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
REDIS_PASSWORD=
# Host-run app: replace each placeholder below with the corresponding secret.
# Compose overrides these three URLs to use container service names.
DATABASE_URL=postgresql://gateway:REPLACE_POSTGRES_PASSWORD@127.0.0.1:5433/gateway
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0

EMBEDDING_BACKEND=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_MAX_BYTES=96000
EMBEDDING_BATCH_WAIT_MS=5
EMBEDDING_QUEUE_SIZE=512
EMBEDDING_WORKERS=2
EMBEDDING_CACHE_SIZE=2048
EMBEDDING_CACHE_TTL_SECONDS=300
EMBEDDING_TIMEOUT_SECONDS=30
# Optional local backend: install requirements-acceleration.txt first.
# EMBEDDING_BACKEND=local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_EMBEDDING_CPU_THREADS=0
# LOCAL_EMBEDDING_REVISION=<tested-immutable-model-commit>
# EMBEDDING_DIM=384
# INSTALL_ACCELERATION=true
# Do not switch model/dimension on an existing vector collection; see operations.md.

SIMPLE_MODEL=claude-haiku-4-5
COMPLEX_MODEL=claude-sonnet-4-5
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_CONCURRENCY=32
PROVIDER_QUEUE_TIMEOUT_SECONDS=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_RESET_SECONDS=30
# MODEL_PRICING={"your-model-id":[input_USD_per_million,output_USD_per_million]}

CACHE_HIT_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600
MEMORY_TTL_SECONDS=2592000
GRAPH_SIMILARITY_THRESHOLD=0.75
GRAPH_CONTEXT_LIMIT=6
GRAPH_CANDIDATE_POOL=24
CONTEXT_MAX_CHARS=10000
RATE_LIMIT_PER_MINUTE=30
TENANT_RATE_LIMIT_PER_MINUTE=600
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=100
MAX_CONCURRENT_REQUESTS=64
GRAPH_OUTBOX_BATCH_SIZE=32
GRAPH_OUTBOX_POLL_SECONDS=1
GRAPH_OUTBOX_CONCURRENCY=4
GRAPH_OUTBOX_LEASE_SECONDS=60
